# Python
venv/
__pycache__/
*.pyc

# Real ZipRecruiter session data — cookies/browser profile are effectively
# login credentials. Never commit these, private repo or not.
scrapers/ziprecruiter_auth.json
scrapers/ziprecruiter_profile/
scrapers/ziprecruiter_cookies_raw.json
scrapers/usajobs_credentials.json

# Scraped job data — regenerable via `python main.py`, and churns on every
# discovery run, which would make for noisy diffs. Remove this line if you
# want the DB itself tracked in git.
db/jobs.db

.DS_Store

# Home page's sweep-in-progress tracker — ephemeral runtime state
dashboard/.sweep_lock.json

# User-adjustable distance/radius settings (close/mid/far tiers, life_change
# search radius) — local machine preference, not project source
dashboard/settings.json
